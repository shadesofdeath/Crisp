// strings.rc — Arayüz dizeleri, dil dil.
//
// app.rc tarafından #include edilir; #pragma code_page(65001) orada kurulduğu
// için burada tekrar edilmez.
//
// YENİ DİL EKLEMEK: buraya bir LANGUAGE + STRINGTABLE bloğu, src/Localization.cpp
// içindeki kLanguages tablosuna bir satır. Başka hiçbir yere dokunulmaz.
//
// EKSİK ÇEVİRİ SORUN DEĞİL: Loc::Str bulunamayan dizeyi İngilizceden alır, o da
// yoksa dilden bağımsız bloktan. Bir dili yarım bırakmak, uygulamayı boş menü
// öğeleriyle bırakmaz.

// ---------------------------------------------------------------------------
// Kısayol etiketleri — dilden bağımsız, tek kopya
// ---------------------------------------------------------------------------
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
STRINGTABLE
BEGIN
    IDS_ACCEL_REGION        "Ctrl+Shift+S"
    IDS_ACCEL_WINDOW        "Ctrl+Shift+W"
    IDS_ACCEL_FULLSCREEN    "Ctrl+Shift+F"
    IDS_ACCEL_DELAYED       "Ctrl+Shift+D"
    IDS_ACCEL_COPY          "Ctrl+C"
    IDS_ACCEL_SELECT_ALL    "Ctrl+A"
    IDS_ACCEL_SAVE          "Ctrl+S"
    IDS_ACCEL_ESC           "Esc"
END

