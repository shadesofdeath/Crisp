// app.rc — Kaynak betiği.
//
// Manifest RC üzerinden gömülür; CMakeLists linker'ın kendi manifestini
// üretmesini /MANIFEST:NO ile engeller, yoksa ikisi çakışır.

#include <windows.h>

#include "resource.h"

#pragma code_page(65001)

// --- Manifest ----------------------------------------------------------------
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

// --- Simgeler ----------------------------------------------------------------
// IDI_APP İLK SIRADA OLMALI: Explorer, kabuk simgesi olarak kaynak sırasındaki
// EN DÜŞÜK kimlikli simgeyi seçer. Tepsi simgeleri öne geçerse dosya
// gezgininde uygulama plakasız bir glif olarak görünür.
IDI_APP        ICON "icons\\app.ico"
IDI_TRAY_DARK  ICON "icons\\tray_dark.ico"
IDI_TRAY_LIGHT ICON "icons\\tray_light.ico"

// --- Arayüz dizeleri ---------------------------------------------------------
// Ayrı dosya: dil blokları bu dosyayı üç katına çıkarırdı ve yeni bir dil
// eklerken sürüm bilgisiyle aynı dosyaya dokunmak gerekmemeli.
#include "strings.rc"

// --- Sürüm bilgisi -----------------------------------------------------------
//
// NUMARA CMAKE'TEN GELİR, BURAYA YAZILMAZ. Üç yerde elle tutulan bir sürüm
// numarası üç yerde birden bayatlar: bu blok 0.1.0 derken CMakeLists 0.5.0,
// CHANGELOG ise 0.5.0 diyordu ve indirilen exe'nin özelliklerinde yanlış sürüm
// görünüyordu. CMakeLists projenin sürümünü tanım olarak geçiriyor (bkz.
// target_compile_definitions), buradaki tek iş onu biçimlendirmek.
#define CRISP_STRINGIFY2(x) #x
#define CRISP_STRINGIFY(x)  CRISP_STRINGIFY2(x)
#define CRISP_VERSION_TEXT                                                        CRISP_STRINGIFY(CRISP_VERSION_MAJOR) "."                                      CRISP_STRINGIFY(CRISP_VERSION_MINOR) "."                                      CRISP_STRINGIFY(CRISP_VERSION_PATCH) ".0"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    CRISP_VERSION_MAJOR,CRISP_VERSION_MINOR,CRISP_VERSION_PATCH,0
    PRODUCTVERSION CRISP_VERSION_MAJOR,CRISP_VERSION_MINOR,CRISP_VERSION_PATCH,0
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
    FILEFLAGS      0
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"   // en-US, Unicode
        BEGIN
            VALUE "CompanyName",      "ShadesOfDeath"
            VALUE "FileDescription",  "Crisp — screen capture"
            VALUE "FileVersion",      CRISP_VERSION_TEXT
            VALUE "InternalName",     "Crisp"
            VALUE "LegalCopyright",   "© 2026 ShadesOfDeath. MIT licensed."
            VALUE "OriginalFilename", "Crisp.exe"
            VALUE "ProductName",      "Crisp"
            VALUE "ProductVersion",   CRISP_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
